rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // HONDU RAITE - STORAGE SECURITY RULES (actualizado)
    // ============================================================
    //
    // Reglas seguras pero funcionales para:
    // - Pasajeros (client)
    // - Conductores (driver)
    // - Supervisores
    // - Admins
    //
    // Principios:
    // - Usuarios autenticados pueden leer la mayoría de archivos (para ver perfiles, verificaciones, etc.)
    // - Solo el dueño (userId) puede subir a su carpeta
    // - Admins/Staff tienen acceso completo para moderación
    // - Limitación de tamaño y tipo de archivo
    // ============================================================

    // === HELPERS ===
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      let email = request.auth.token.email;
      // Email principal del admin + UID de respaldo
      return email == 'josuesoza0513@gmail.com' || request.auth.uid == 'GOsIqh5xgoSsx8lRC0ZXxLYVUEm2';
    }

    function isStaff() {
      // En el futuro puedes mejorar esto leyendo el rol desde Firestore
      // Por ahora usamos email/UID + permitimos supervisores si quieres
      return isAdmin();
    }

    function isImageOrPdf() {
      // image/* (jpeg, png, webp, heic…), PDF, u octet-stream (algunos Android no mandan MIME)
      return request.resource.contentType.matches('image/.*')
             || request.resource.contentType == 'application/pdf'
             || request.resource.contentType == 'application/octet-stream'
             || request.resource.contentType == 'application/x-octet-stream'
             || request.resource.contentType == '';
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/.*')
             || request.resource.contentType == 'application/octet-stream'
             || request.resource.contentType == 'application/x-octet-stream'
             || request.resource.contentType == '';
    }

    // Carpetas con datos personales sensibles dentro de users/{uid}/
    // (resource.name = ruta completa del archivo; si no existe, la lectura se niega igual)
    function privateFolder() {
      return resource.name.matches('^artifacts/[^/]+/users/[^/]+/(verification|resubmit|deposits|surveys)/.*$');
    }

    function maxSize(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // ============================================================
    // ARCHIVOS DE USUARIOS (perfil, verificación, vehículos)
    // ============================================================

    // Audios de encuesta de cancelación
    match /artifacts/{appId}/users/{userId}/surveys/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId)
                   && maxSize(8)
                   && isAudio();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Carpeta general de cada usuario
    match /artifacts/{appId}/users/{userId}/{allPaths=**} {
      // Cualquiera autenticado puede leer fotos de perfil, vehículos y tiendas.
      // Cédulas, selfies de verificación, comprobantes de depósito y audios NO (ver sus reglas abajo).
      // El panel de staff los ve con la URL de descarga guardada en el perfil (lleva token; no pasa por aquí).
      allow read: if isSignedIn() && !privateFolder();

      // Solo el dueño puede escribir
      allow write: if isOwner(userId) 
                   && maxSize(10)
                   && isImageOrPdf();
    }

    // Verificación de identidad (selfie, cédula, etc.)
    match /artifacts/{appId}/users/{userId}/verification/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) 
                   && maxSize(10)
                   && isImageOrPdf();
    }

    // Reenvío de verificación
    match /artifacts/{appId}/users/{userId}/resubmit/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) 
                   && maxSize(10)
                   && isImageOrPdf();
    }

    // Fotos de vehículos
    match /artifacts/{appId}/users/{userId}/vehicles/{vehicleId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) 
                   && maxSize(10)
                   && isImageOrPdf();
    }

    // ============================================================
    // TIENDAS VIRTUALES (logo + fotos de productos del emprendedor)
    // Ruta que usa merchant-stores.js:
    //   artifacts/{appId}/users/{uid}/store_logos/...
    //   artifacts/{appId}/users/{uid}/store_products/...
    // El dueño autenticado puede subir; lectura autenticada (catálogo).
    // ============================================================

    match /artifacts/{appId}/users/{userId}/store_logos/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId)
                   && maxSize(12)
                   && isImageOrPdf();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /artifacts/{appId}/users/{userId}/store_products/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId)
                   && maxSize(12)
                   && isImageOrPdf();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ============================================================
    // DEPÓSITOS DE CONDUCTORES
    // ============================================================

    match /artifacts/{appId}/users/{userId}/deposits/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) 
                   && maxSize(10)
                   && isImageOrPdf();
    }

    // ============================================================
    // CONFIGURACIÓN Y LOGOS DE LA APP (solo admin)
    // ============================================================

    match /artifacts/{appId}/settings/{allPaths=**} {
      allow read: if true;   // público para que la app cargue logos, etc.
      allow write: if isAdmin();
    }

    // ============================================================
    // ASSETS PÚBLICOS (iconos, logos generales, etc.)
    // ============================================================

    match /artifacts/{appId}/public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // APK de la app Android (solo admin; descarga pública)
    match /artifacts/{appId}/public/apk/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 200 * 1024 * 1024
                   && (
                     request.resource.contentType == 'application/vnd.android.package-archive'
                     || request.resource.contentType == 'application/octet-stream'
                     || request.resource.contentType.matches('application/.*')
                   );
      allow delete: if isAdmin();
    }

    // ============================================================
    // CATCH-ALL (por seguridad)
    // ============================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}