rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HONDU RAITE - FIRESTORE SECURITY RULES v2 (actualizado)
    // ============================================================
    // 
    // Esta versión está diseñada para:
    // - No romper las funciones actuales de Pasajero, Conductor, Supervisor y Admin
    // - Dar solo los permisos necesarios según lo que cada rol ve en su pantalla
    // - Ser más segura que las reglas abiertas anteriores
    //
    // Si algo deja de funcionar después de desplegar, dime la pantalla/acción
    // y lo ajustamos inmediatamente.
    // ============================================================

    // === HELPERS ===
    function isSignedIn() {
      return request.auth != null;
    }

    function requestUid() {
      return request.auth.uid;
    }

    // ------------------------------------------------------------
    // ROLES DE CONFIANZA (menú por rol, oct 2026)
    // El rol de staff YA NO sale del perfil (el usuario lo puede editar).
    // Fuentes que solo escribe el servidor:
    //   1) artifacts/{app}/roles/{uid}  (callable setUserRole / migración; write: false aquí)
    //   2) custom claim `role` del token de Firebase Auth (mismo origen)
    //   3) correo de Firebase Auth del admin supremo (y correo de staff conocido) — respaldo anti-bloqueo
    // El doc de roles manda si existe (una degradación se aplica al momento, aunque el token sea viejo).
    // ------------------------------------------------------------
    function authEmail() {
      return request.auth.token.get('email', '');
    }

    function trustedStaffRole(app) {
      let p = /databases/$(database)/documents/artifacts/$(app)/roles/$(requestUid());
      return exists(p) ? get(p).data.get('role', '') : request.auth.token.get('role', '');
    }

    // Perfil público / privado (rol informativo: pasajero o conductor; NO da permisos de staff).
    // Antes: `userDoc.exists` no existe en reglas → error → false (supervisores fallaban isStaff()).
    function getRole(app) {
      let p = /databases/$(database)/documents/artifacts/$(app)/public/data/users/$(requestUid());
      return exists(p) ? get(p).data.get('role', null) : null;
    }

    function isAdmin(app) {
      return isSignedIn() && (
        authEmail() == 'josuesoza0513@gmail.com'
        || trustedStaffRole(app) == 'admin'
      );
    }

    // Supervisor o admin. Una sola lectura del doc de roles (límite de expresiones por regla).
    function isSupervisor(app) {
      return isSignedIn() && (
        authEmail() in ['josuesoza0513@gmail.com', 'sozajob146@gmail.com']
        || trustedStaffRole(app) in ['admin', 'supervisor']
      );
    }

    function getPrivateRole(app) {
      let p = /databases/$(database)/documents/artifacts/$(app)/users/$(requestUid())/profile/data;
      return exists(p) ? get(p).data.get('role', null) : null;
    }

    // Público o privado: perfiles viejos a veces solo tienen role en uno de los dos
    function isDriver(app) {
      return getRole(app) == 'driver'
        || getPrivateRole(app) == 'driver'
        || request.auth.token.get('role', '') == 'driver'
        || exists(/databases/$(database)/documents/artifacts/$(app)/public/data/drivers_location/$(requestUid()));
    }

    function isClient(app) {
      let role = getRole(app);
      // null / vacío / client = pasajero; no exigir role exacto para no romper perfiles viejos
      return role == 'client' || role == null || role == '';
    }

    function isStaff(app) {
      return isSupervisor(app);
    }

    // Campos de perfil que el usuario NO puede tocar en su propio perfil.
    // role: solo puede quedar en pasajero/conductor (staff lo da el servidor).
    function profileRoleChangeOk(app) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['role'])
          || request.resource.data.get('role', 'client') in ['client', 'driver', null, '']
          || isAdmin(app))
        && (!changed.hasAny(['staffGrantedBy', 'staffGrantedAt'])
          || isAdmin(app)
          || (request.resource.data.get('staffGrantedBy', null) == null
            && request.resource.data.get('staffGrantedAt', null) == null))
        && (!changed.hasAny(['isTestAccount', 'testAccountKind']) || isStaff(app))
        && !changed.hasAny(['lastPushTest', 'roleClaim', 'trustedRole']);
    }

    function profileCreateOk() {
      let d = request.resource.data;
      return d.get('role', 'client') in ['client', 'driver', null, '']
        && d.get('staffGrantedBy', null) == null
        && d.get('staffGrantedAt', null) == null
        && !d.keys().hasAny(['isTestAccount', 'testAccountKind', 'lastPushTest', 'roleClaim', 'trustedRole']);
    }

    // Campos del panel Viajes que solo escribe el servidor (callables / Admin SDK).
    // Colecciones con reglas propias que el catch-all público NO debe abrir.
    function catchAllExcluded() {
      return ['stores', 'store_orders', 'delivery_zones', 'delivery_zone_settings', 'store_delivery_fees', 'delivery_zone_history',
        'support_tickets', 'verification_alerts', 'driver_payout_records', 'driver_payout_bank_events', 'driver_deposits',
        'balance_adjustments', 'permission_logs', 'notification_campaigns', 'wa_invite_contacted', 'trip_purge_log',
        'whatsapp_cloud_inbox', 'whatsapp_cloud_outbox', 'whatsapp_cloud_statuses', 'whatsapp_cloud_events',
        'whatsapp_booking_sessions', 'whatsapp_assistant_dedup', 'account_deletions', 'auth_phone_index', 'platformConfig'];
    }

    // Pedidos de tiendas: campos de la tarifa de envío por zona (solo servidor).
    function storeOrderZoneKeys() {
      return ['deliveryZoneId', 'deliveryZoneName', 'deliveryFeeSource', 'deliveryFeeQuotedAtMs'];
    }

    function tripServerOnlyKeys() {
      return ['trashedAtMs', 'trashedBy', 'trashedByName', 'trashPurgeAfterMs', 'trashStatusAtMove',
        'restoredAtMs', 'restoredBy', 'restoredByName',
        'staffReviewedAtMs', 'staffReviewedBy', 'staffReviewedByName', 'pinRevealLog',
        'deliveredTo', 'alertNotifiedDriverIds', 'alertFcmOkDriverIds', 'alertNoTokenDriverIds', 'alertFirstNotifiedAtMs',
        'resendCount', 'lastResendAtMs', 'lastResendReason', 'lastResendBy', 'lastResendByName',
        'lastResendPushed', 'lastResendNotified', 'lastResendNoToken', 'autoResendAtMs', 'autoResendAfterSeconds'];
    }

    // === EDAD (+18) ===
    // Mayor de edad según la fecha de nacimiento del perfil (YYYY-MM-DD o Timestamp).
    // Sin fecha o con formato raro = NO es mayor (no recibe tiendas +18).
    // request.time está en UTC (Honduras es UTC-6): el cambio a 18 puede llegar unas horas antes.
    function isAdultYmd(y, m, d) {
      let ny = request.time.year();
      let nm = request.time.month();
      let nd = request.time.day();
      return ny - y > 18
        || (ny - y == 18 && (nm > m || (nm == m && nd >= d)));
    }

    function isAdultBirthDate(bd) {
      return (bd is string
          && bd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && isAdultYmd(int(bd.split('-')[0]), int(bd.split('-')[1]), int(bd.split('-')[2])))
        || (bd is timestamp && isAdultYmd(bd.year(), bd.month(), bd.day()));
    }

    // Busca birthDate en el perfil público y, si no está, en el privado.
    function isAdultUser(app) {
      let pub = get(/databases/$(database)/documents/artifacts/$(app)/public/data/users/$(requestUid()));
      let priv = get(/databases/$(database)/documents/artifacts/$(app)/users/$(requestUid())/profile/data);
      return (pub != null && isAdultBirthDate(pub.data.get('birthDate', null)))
        || (priv != null && isAdultBirthDate(priv.data.get('birthDate', null)));
    }

    // Staff para LEER tiendas +18 (rol de confianza, no el perfil).
    function isStoresReaderStaff(app) {
      return isStaff(app);
    }

    function isOwner(userId) {
      return isSignedIn() && requestUid() == userId;
    }

    // Pasajero con identidad verificada/aprobada (Copa Pasajeros y similares)
    function isVerifiedPassengerUser(app, userId) {
      let p = /databases/$(database)/documents/artifacts/$(app)/public/data/users/$(userId);
      let userDoc = exists(p) ? get(p) : null;
      return userDoc != null && (
        userDoc.data.approvalStatus == 'approved'
        || (userDoc.data.verified == true && userDoc.data.approvalStatus != 'pending')
      );
    }

    // Conductor aprobado para Copa (no pending/suspended/rejected)
    function isApprovedDriverUser(app, userId) {
      let p = /databases/$(database)/documents/artifacts/$(app)/public/data/users/$(userId);
      let userDoc = exists(p) ? get(p) : null;
      return userDoc != null
        && userDoc.data.approvalStatus != 'pending'
        && userDoc.data.approvalStatus != 'suspended'
        && userDoc.data.approvalStatus != 'rejected'
        && (
          userDoc.data.approvalStatus == 'approved'
          || userDoc.data.verified == true
        );
    }

    // Pedir viaje para uno mismo (pasajero, admin de prueba, supervisor, etc.)
    // El bloqueo de "conductor puro" se hace en la app; aquí basta autenticación + clientId propio.
    function isSelfTripCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasAll(['clientId', 'status'])
        && request.resource.data.clientId == requestUid()
        && request.resource.data.status in ['pending', 'scheduled'];
    }

    function isTripParticipant() {
      return resource.data.clientId == requestUid()
        || resource.data.driverId == requestUid()
        || resource.data.offeredToDriverId == requestUid();
    }

    function isGuestClientTrip() {
      return resource.data.guestClient == true
        || resource.data.guestInvitePending == true
        || (resource.data.clientId is string && resource.data.clientId.matches('guest_.*'));
    }

    // Conductor asignado al viaje (puede actualizar y completar)
    function isAssignedDriver() {
      return isSignedIn()
        && resource.data.keys().hasAll(['driverId'])
        && resource.data.driverId == requestUid();
    }

    // Completar viaje: conductor o pasajero del viaje, o staff
    function canCompleteTrip(app) {
      return isAssignedDriver()
        || (resource.data.clientId == requestUid())
        || isStaff(app);
    }

    // ============================================================
    // PERFILES DE USUARIO
    // ============================================================

    // Perfil PÚBLICO
    match /artifacts/{app}/public/data/users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && (profileCreateOk() || isAdmin(app));
      allow update: if isSignedIn() && (isOwner(userId) || isStaff(app)) && profileRoleChangeOk(app);
      allow delete: if isSignedIn() && (isOwner(userId) || isStaff(app));
    }

    // Perfil PRIVADO
    match /artifacts/{app}/users/{userId}/profile/data {
      allow read: if isSignedIn() && (isOwner(userId) || isStaff(app));
      allow create: if isSignedIn() && ((isOwner(userId) && profileCreateOk()) || isAdmin(app));
      allow update: if isSignedIn() && (isOwner(userId) || isStaff(app)) && profileRoleChangeOk(app);
      allow delete: if isSignedIn() && (isOwner(userId) || isStaff(app));
    }

    // ROLES de confianza: solo el servidor escribe (Admin SDK). El dueño y staff pueden leer.
    match /artifacts/{app}/roles/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isStaff(app));
      allow write: if false;
    }

    // ============================================================
    // VIAJES
    // ============================================================

    match /artifacts/{app}/public/data/trips/{tripId} {
      // get: también viajes guest/WhatsApp por el link (ID), incluso SIN cuenta.
      // list: no enumerar todos los guest.
      allow get: if (
        isGuestClientTrip()
        && resource.data.status in ['pending', 'accepted', 'in_progress', 'scheduled', 'completed']
      ) || (isSignedIn() && (
        isStaff(app) ||
        resource.data.clientId == requestUid() ||
        resource.data.driverId == requestUid() ||
        resource.data.offeredToDriverId == requestUid() ||
        resource.data.status == 'pending' ||
        resource.data.status == 'scheduled' ||
        (
          isGuestClientTrip()
          && resource.data.status in ['pending', 'accepted', 'in_progress', 'scheduled']
        )
      ));
      allow list: if isSignedIn() && (
        isStaff(app) ||
        resource.data.clientId == requestUid() ||
        resource.data.driverId == requestUid() ||
        resource.data.offeredToDriverId == requestUid() ||
        resource.data.status == 'pending' ||
        resource.data.status == 'scheduled'
      );

      // CREAR viaje
      // Antes: solo isClient(role==client|null) → fallaba admin/supervisor y perfiles con role raro
      // Ahora: cualquiera autenticado puede crear viaje PARA SÍ (clientId == uid)
      // Staff puede armar viaje para un cliente (staffAssistedClient)
      // Emprendedor puede crear delivery al marcar pedido de tienda listo (createdByMerchant)
      allow create: if !request.resource.data.keys().hasAny(tripServerOnlyKeys()) && (isSelfTripCreate()
        || (
          isSignedIn()
          && isStaff(app)
          && request.resource.data.keys().hasAll(['clientId'])
          && request.resource.data.clientId is string
          && request.resource.data.clientId.size() > 0
          && request.resource.data.staffAssistedClient == true
        )
        || (
          isSignedIn()
          && request.resource.data.createdByMerchant == true
          && request.resource.data.merchantId == requestUid()
          && request.resource.data.serviceType == 'delivery'
          && request.resource.data.status == 'pending'
          && request.resource.data.storeOrderId is string
          && request.resource.data.storeOrderId.size() > 0
          && request.resource.data.clientId is string
          && request.resource.data.clientId.size() > 0
        ));

      // Cancelar: pasajero o conductor asignado en viaje activo (pending/accepted/in_progress/scheduled)
      // ACTUALIZAR / CANCELAR: dueño (pasajero), conductor asignado, ofertado, staff
      // Conductores pueden tocar pending (ofertas / visto / regateo / rechazar)
      // Invitado staff (sin cuenta): al registrarse reclama el viaje y se asigna clientId = uid
      // Conductor asignado: llegada, PIN, en curso, completar (status completed), GPS en doc
      // Papelera / revisado / embudo: solo callables (nadie los escribe desde la app).
      allow update: if isSignedIn()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(tripServerOnlyKeys())
        && (
        isStaff(app)
        || isTripParticipant()
        || isAssignedDriver()
        // Cancelar viaje (pasajero o conductor del viaje, no solo staff)
        || (
          isTripParticipant()
          && resource.data.status in ['pending', 'accepted', 'in_progress', 'scheduled']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.clientId == resource.data.clientId
        )
        // Completar viaje explícitamente (conductor o pasajero del viaje)
        || (
          canCompleteTrip(app)
          && resource.data.status in ['accepted', 'in_progress']
          && request.resource.data.status == 'completed'
          && request.resource.data.clientId == resource.data.clientId
          && (
            !resource.data.keys().hasAll(['driverId'])
            || request.resource.data.driverId == resource.data.driverId
          )
        )
        // Conductor asignado: cualquier update mientras el viaje esté activo
        // (driverArrived, driverLive*, commission*, completedAt, etc.)
        || (
          isAssignedDriver()
          && resource.data.status in ['accepted', 'in_progress']
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.status in ['accepted', 'in_progress', 'completed', 'cancelled']
        )
        || (resource.data.status in ['pending', 'scheduled'] && isDriver(app))
        // Candidato de oferta (aunque no sea offeredToDriverId todavía): puede declinar
        || (
          resource.data.status == 'pending'
          && isDriver(app)
          && request.resource.data.status == 'pending'
          && request.resource.data.clientId == resource.data.clientId
        )
        // Pasar: cualquier sesión autenticada puede ocultarse a sí misma (arrayUnion uid)
        || (
          isSignedIn()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['declinedDriverIds', 'driverBids', 'offeredToDriverId', 'offeredToDriverName', 'offerSentAt', 'offerDistanceKm', 'candidateDriverIds'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['offeredToDriverId'])
            || resource.data.offeredToDriverId == requestUid()
          )
        )
        // Viaje armado para cliente NUEVO (guest_…): el pasajero autenticado reclama 1 vez
        || (
          resource.data.status == 'pending'
          && resource.data.staffAssistedClient == true
          && resource.data.staffCreatedClientClaimed != true
          && isGuestClientTrip()
          && request.resource.data.clientId == requestUid()
          && request.resource.data.staffCreatedClientClaimed == true
          && request.resource.data.staffAssistedClient == true
        )
        // WhatsApp/guest ya confirmado: al abrir el link, el pasajero se adueña para ver mapa y viaje activo
        || (
          isGuestClientTrip()
          && resource.data.status in ['pending', 'accepted', 'in_progress', 'scheduled']
          && request.resource.data.clientId == requestUid()
          && request.resource.data.status == resource.data.status
          && (
            !resource.data.keys().hasAll(['driverId'])
            || request.resource.data.driverId == resource.data.driverId
          )
        )
      );

      // Borrar solo staff
      allow delete: if isSignedIn() && isStaff(app);
    }

    // ============================================================
    // UBICACIÓN EN TIEMPO REAL DE CONDUCTORES
    // ============================================================

    match /artifacts/{app}/public/data/drivers_location/{driverId} {
      allow read: if isSignedIn();                    // necesario para mapas y tracking
      allow write: if isSignedIn() && (isOwner(driverId) || isStaff(app));
    }

    // ============================================================
    // MODERACIÓN (Reportes, Encuestas, Feedback)
    // ============================================================

    match /artifacts/{app}/public/data/reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isStaff(app) || resource.data.reportedBy == requestUid());
      allow update: if isSignedIn() && isStaff(app);
    }

    match /artifacts/{app}/public/data/cancellation_surveys/{surveyId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isStaff(app) || resource.data.respondentId == requestUid());
      allow update: if isSignedIn() && isStaff(app);
    }

    match /artifacts/{app}/public/data/app_feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isStaff(app) || resource.data.userId == requestUid());
      allow update: if isSignedIn() && isStaff(app);
    }

    // ============================================================
    // VEHÍCULOS Y VERIFICACIÓN (conductor y staff)
    // ============================================================

    match /artifacts/{app}/users/{userId}/vehicles/{vehicleId} {
      allow read, write: if isSignedIn() && (isOwner(userId) || isStaff(app));
    }

    match /artifacts/{app}/users/{userId}/verification/{document=**} {
      allow read, write: if isSignedIn() && (isOwner(userId) || isStaff(app));
    }

    match /artifacts/{app}/users/{userId}/resubmit/{document=**} {
      allow read, write: if isSignedIn() && (isOwner(userId) || isStaff(app));
    }

    // ============================================================
    // DATOS OPERATIVOS DE STAFF
    // ============================================================

    // Depósitos de conductores (comprobantes / baucher)
    // - Staff: leer, validar, rechazar, borrar, crear condonaciones
    // - Conductor: crear su solicitud y leer SOLO las suyas (listener de estado)
    match /artifacts/{app}/public/data/driver_deposit_requests/{requestId} {
      allow read: if isSignedIn() && (
        isStaff(app)
        || resource.data.driverId == requestUid()
      );
      allow create: if isSignedIn() && (
        isStaff(app)
        || (
          isDriver(app)
          && request.resource.data.driverId == requestUid()
        )
      );
      allow update, delete: if isSignedIn() && isStaff(app);
    }

    // Eventos de sesión del conductor (cierre de turno / descanso)
    // addDoc genera un id aleatorio → no puede usarse isOwner(docId)
    match /artifacts/{app}/public/data/driver_session_events/{eventId} {
      allow create: if isSignedIn()
        && isDriver(app)
        && request.resource.data.driverId == requestUid();
      allow read: if isSignedIn() && (
        isStaff(app)
        || resource.data.driverId == requestUid()
      );
      allow update, delete: if isSignedIn() && isStaff(app);
    }

    // Notificaciones: staff crea broadcasts; conductor puede avisar a supervisores al cerrar sesión
    match /artifacts/{app}/public/data/notifications/{notifId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isStaff(app)
        || (
          isDriver(app)
          && request.resource.data.sentBy == requestUid()
          && request.resource.data.targetRole in ['supervisor', 'admin', 'staff']
        )
      );
      allow update, delete: if isSignedIn() && isStaff(app);
    }

    // ============================================================
    // CONFIGURACIÓN Y OTRAS COLECCIONES PÚBLICAS
    // ============================================================

    match /artifacts/{app}/public/data/appSettings/{doc} {
      // Logo, bienvenida, APK y config se leen en el login (aún sin sesión)
      allow read: if true;
      allow write: if isSignedIn() && isStaff(app);
    }

    // ============================================================
    // RECARGAS DE PASAJEROS (solicitudes de saldo)
    // ============================================================
    match /artifacts/{app}/public/data/recharge_requests/{requestId} {
      // Pasajero puede crear su propia solicitud
      allow create: if isSignedIn() &&
        request.resource.data.passengerId == requestUid() &&
        request.resource.data.status == 'pending';

      // Pasajero ve solo sus solicitudes; staff ve todas
      allow read: if isSignedIn() && (
        isStaff(app) ||
        resource.data.passengerId == requestUid()
      );

      // Solo staff aprueba/rechaza
      allow update: if isSignedIn() && isStaff(app);
    }

    // Cuentas bancarias (solo staff administra, todos leen para recargar)
    match /artifacts/{app}/public/data/bankAccounts/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isStaff(app);
    }

    // Promociones (lectura usuarios autenticados; escritura staff)
    match /artifacts/{app}/public/data/promotions/{promoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isStaff(app);
    }

    // ============================================================
    // TIENDAS VIRTUALES (emprendedores / marketplace tipo PedidosYa)
    // ============================================================

    match /artifacts/{app}/public/data/stores/{storeId} {
      // +18 filtrado en el servidor: una tienda adultsOnly == true solo la leen
      // el dueño, staff o cuentas con 18+ por fecha de nacimiento.
      // IMPORTANTE: las reglas no son filtros. La lista general debe consultar
      // where('adultsOnly', '==', false); una consulta sin ese filtro falla
      // (permission-denied) para menores y cuentas sin fecha de nacimiento.
      // Sin .get(campo, default): en consultas el default hace pasar la regla aunque
      // la consulta no filtre adultsOnly (probado en emulador). Tiendas sin el campo
      // solo las leen dueño/staff/adultos hasta correr el script de backfill.
      allow get, list: if isSignedIn() && (
        resource.data.adultsOnly == false
        || resource.data.ownerId == requestUid()
        || isStoresReaderStaff(app)
        || isAdultUser(app)
      );
      // Crear tienda: dueño; verificación siempre pending (no auto-aprobar)
      // adultsOnly siempre presente (bool) para que la consulta general la encuentre
      allow create: if isSignedIn()
        && request.resource.data.ownerId == requestUid()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.adultsOnly is bool
        && (
          !('approvalStatus' in request.resource.data)
          || request.resource.data.approvalStatus == 'pending'
        );
      // Staff: todo. Dueño: editar datos pero NO auto-aprobarse.
      // Solo puede poner approvalStatus a pending (reenvío tras rechazo).
      allow update: if isSignedIn() && (
        isStaff(app)
        || (
          resource.data.ownerId == requestUid()
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['approvalStatus', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'rejectionReason'])
            || (
              request.resource.data.approvalStatus == 'pending'
              && resource.data.approvalStatus == 'rejected'
            )
          )
          // El dueño no puede quitar la marca +18 (solo staff)
          && !(
            resource.data.get('adultsOnly', false) == true
            && request.resource.data.get('adultsOnly', false) != true
          )
        )
      );
      allow delete: if isSignedIn() && (
        isStaff(app)
        || resource.data.ownerId == requestUid()
      );
    }

    match /artifacts/{app}/public/data/store_products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == requestUid()
        && request.resource.data.storeId is string;
      allow update, delete: if isSignedIn() && (
        isStaff(app)
        || resource.data.ownerId == requestUid()
      );
    }

    match /artifacts/{app}/public/data/store_orders/{orderId} {
      // Cliente, dueño de tienda y staff ven el pedido
      allow read: if isSignedIn() && (
        isStaff(app)
        || resource.data.clientId == requestUid()
        || resource.data.ownerId == requestUid()
      );
      // Cliente crea su pedido. La tarifa de envío por zona la pone el servidor
      // (onStoreOrderCreatedZoneFee): el cliente no puede mandar esos campos.
      allow create: if isSignedIn()
        && request.resource.data.clientId == requestUid()
        && request.resource.data.status == 'pending'
        && request.resource.data.storeId is string
        && request.resource.data.ownerId is string
        && !request.resource.data.keys().hasAny(storeOrderZoneKeys())
        && request.resource.data.get('deliveryFee', null) == null;
      // Cliente puede cancelar; dueño avanza estados; staff todo.
      // Nadie fuera de staff toca la zona; con tarifa de zona, el dueño tampoco cambia el monto.
      allow update: if isSignedIn() && (
        isStaff(app)
        || (
          (
            resource.data.ownerId == requestUid()
            || (
              resource.data.clientId == requestUid()
              && request.resource.data.status == 'cancelled'
            )
          )
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(storeOrderZoneKeys())
          && !(
            resource.data.get('deliveryFeeSource', '') in ['zone_base', 'store_custom']
            && request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveryFee'])
          )
        )
      );
      allow delete: if isSignedIn() && isStaff(app);
    }

    // ============================================================
    // ZONAS DE ENVÍO (tarifa fija por zona). Escribe solo el servidor (callables).
    // ============================================================
    match /artifacts/{app}/public/data/delivery_zones/{zoneId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /artifacts/{app}/public/data/delivery_zone_settings/{cityId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /artifacts/{app}/public/data/store_delivery_fees/{storeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    // Historial (quién, cuándo, antes/después): solo staff lo lee; nadie lo edita ni borra.
    match /artifacts/{app}/public/data/delivery_zone_history/{entryId} {
      allow read: if isSignedIn() && isStaff(app);
      allow write: if false;
    }

    // Copa HonduRaite — retos globales conductores (ranking público: todos los logueados leen)
    // Entrada, suma de viajes y reclamo: solo conductores aprobados
    match /artifacts/{app}/public/data/driver_global_challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isStaff(app);

      match /entries/{driverId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.driverUid == driverId
          && (
            isStaff(app)
            || (isOwner(driverId) && isApprovedDriverUser(app, driverId))
          );
        allow update: if isSignedIn() && (
          isStaff(app)
          || (
            isOwner(driverId)
            && resource.data.driverUid == requestUid()
            && isApprovedDriverUser(app, driverId)
          )
        );
        allow delete: if isSignedIn() && isStaff(app);
      }
    }

    // Copa HonduRaite — retos globales pasajeros (ranking público)
    // Entrada al ranking, suma de viajes y reclamo de premios: solo clientes verificados
    match /artifacts/{app}/public/data/passenger_global_challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isStaff(app);

      match /entries/{passengerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.passengerUid == passengerId
          && (
            isStaff(app)
            || (isOwner(passengerId) && isVerifiedPassengerUser(app, passengerId))
          );
        allow update: if isSignedIn() && (
          isStaff(app)
          || (
            isOwner(passengerId)
            && resource.data.passengerUid == requestUid()
            && isVerifiedPassengerUser(app, passengerId)
          )
        );
        allow delete: if isSignedIn() && isStaff(app);
      }
    }

    // Bonos reclamados por pasajero (solo lectura; escritura vía Cloud Functions)
    match /artifacts/{app}/users/{userId}/claimed_promos/{claimId} {
      allow read: if isSignedIn() && (isOwner(userId) || isStaff(app));
      allow write: if false;
    }

    // Códigos de referido: el ID del doc es el CÓDIGO (no el uid).
    // El catch-all exige isOwner(docId) y bloqueaba a conductores/pasajeros.
    match /artifacts/{app}/public/data/referral_codes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == requestUid();
      allow update: if isSignedIn() && (
        isStaff(app)
        || (resource.data.uid == requestUid() && request.resource.data.uid == requestUid())
      );
      allow delete: if isStaff(app)
        || (isSignedIn() && resource.data.uid == requestUid());
    }

    // Eventos de referido: ID automático, no es el uid
    match /artifacts/{app}/public/data/referral_events/{eventId} {
      allow read: if isSignedIn() && (
        isStaff(app)
        || resource.data.referrerUid == requestUid()
        || resource.data.referredUid == requestUid()
      );
      allow create: if isSignedIn()
        && request.resource.data.referredUid == requestUid();
      allow update: if isSignedIn() && (
        isStaff(app)
        || resource.data.referredUid == requestUid()
        || resource.data.referrerUid == requestUid()
      );
      allow delete: if isStaff(app);
    }

    // ============================================================
    // DATOS SENSIBLES (antes los abría el catch-all a cualquier cuenta)
    // ============================================================

    // Soporte: cada quien crea su ticket; solo staff lo lee y lo resuelve.
    match /artifacts/{app}/public/data/support_tickets/{ticketId} {
      allow create: if isSignedIn() && (request.resource.data.get('userId', null) == requestUid() || isStaff(app));
      allow read: if isSignedIn() && (isStaff(app) || resource.data.get('userId', null) == requestUid());
      allow update, delete: if isSignedIn() && isStaff(app);
    }

    // Alertas de verificación (fotos de identidad, teléfono): crea el dueño; lee staff.
    match /artifacts/{app}/public/data/verification_alerts/{alertId} {
      allow create: if isSignedIn() && (request.resource.data.get('uid', null) == requestUid() || isStaff(app));
      allow read, update, delete: if isSignedIn() && isStaff(app);
    }

    // Cambios de cuenta bancaria del conductor: los registra el propio conductor; lee staff.
    match /artifacts/{app}/public/data/driver_payout_bank_events/{eventId} {
      allow create: if isSignedIn() && (request.resource.data.get('driverId', null) == requestUid() || isStaff(app));
      allow read, update, delete: if isSignedIn() && isStaff(app);
    }

    // Errores de permisos (diagnóstico): cada quien registra el suyo; lee staff.
    match /artifacts/{app}/public/data/permission_logs/{logId} {
      allow create: if isSignedIn() && request.resource.data.get('uid', null) == requestUid();
      allow read, update, delete: if isSignedIn() && isStaff(app);
    }

    // Depósitos y pagos a conductores: el conductor ve los suyos; escribe staff.
    match /artifacts/{app}/public/data/driver_deposits/{depositId} {
      allow read: if isSignedIn() && (isStaff(app) || resource.data.get('driverId', null) == requestUid());
      allow write: if isSignedIn() && isStaff(app);
    }

    match /artifacts/{app}/public/data/driver_payout_records/{recordId} {
      allow read: if isSignedIn() && (isStaff(app) || resource.data.get('driverId', null) == requestUid());
      allow write: if isSignedIn() && isStaff(app);
    }

    // Herramientas internas de staff.
    match /artifacts/{app}/public/data/{collection}/{docId} {
      allow read, write: if isSignedIn() && isStaff(app)
        && collection in ['balance_adjustments', 'notification_campaigns', 'wa_invite_contacted'];
    }

    // Solo servidor (Cloud Functions): staff puede leer, nadie escribe desde la app.
    match /artifacts/{app}/public/data/{collection}/{docId} {
      allow read: if isSignedIn() && isStaff(app)
        && collection in ['trip_purge_log', 'whatsapp_cloud_inbox', 'whatsapp_cloud_outbox', 'whatsapp_cloud_statuses',
          'whatsapp_cloud_events', 'whatsapp_booking_sessions', 'whatsapp_assistant_dedup', 'account_deletions'];
    }

    // Comisión y ajustes del panel Viajes: los lee la app; solo el admin los cambia
    // (antes cualquier supervisor podía cambiar el % por el catch-all). El panel guarda vía callable.
    match /artifacts/{app}/public/data/platformConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(app);
    }

    // Índice teléfono → correo para «Entrar con teléfono». El ID es el teléfono (no el uid), así que el
    // catch-all (isOwner(docId)) nunca dejaba escribirlo. Cada quien escribe el de su teléfono sin pisar
    // el de otra cuenta. Leerlo sin sesión no se puede: lo busca el callable resolvePhoneLoginEmail.
    match /artifacts/{app}/public/data/auth_phone_index/{phoneKey} {
      allow read: if isSignedIn() && (isStaff(app) || resource.data.get('uid', null) == requestUid());
      allow create: if isSignedIn() && (isStaff(app) || request.resource.data.get('uid', null) == requestUid());
      allow update: if isSignedIn() && (isStaff(app)
        || (resource.data.get('uid', null) == requestUid() && request.resource.data.get('uid', null) == requestUid()));
      allow delete: if isSignedIn() && (isStaff(app) || resource.data.get('uid', null) == requestUid());
    }

    // Catch-all para otras colecciones públicas
    // 'stores' queda fuera: si no, este allow read (que se suma con OR a la regla de
    // stores) dejaría que cualquier cuenta leyera tiendas +18.
    // 'users' y 'trips' tampoco se escriben por aquí: este allow write (OR) se saltaba las
    // protecciones de rol/staff del perfil y los campos de papelera del viaje.
    // 'store_orders' y las colecciones de zonas de envío también quedan fuera: si no, el
    // historial se leía por cualquier cuenta, cualquiera leía pedidos ajenos (direcciones,
    // teléfonos) y un docId == uid saltaba el candado de la tarifa por zona.
    match /artifacts/{app}/public/data/{collection}/{docId} {
      allow read: if isSignedIn() && !(collection in catchAllExcluded());
      allow write: if isSignedIn() && !(collection in catchAllExcluded() || collection in ['users', 'trips']) && (isOwner(docId) || isStaff(app));
    }

    // Seguridad por defecto
    match /{document=**} {
      allow read, write: if false;
    }

  }
}